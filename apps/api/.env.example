# ============================================================
# NETIFY API ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netify?schema=public"

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_min_32_characters_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Resend Transactional Email Configuration (BACKEND ONLY)
# Never expose or commit the API key.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@netify.africa
RESEND_FROM_NAME=Netify

# Mobile App & Web Verification Links
AUTH_VERIFICATION_URL="netify://verify-email?token={token}&email={email}"
AUTH_RESET_URL="netify://reset-password?token={token}&email={email}"

# Redis (Queue & Caching)
REDIS_URL="redis://localhost:6379"

# ElevenLabs Voice AI (Domain 09.1 Voice Assistant)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# AI Multi-Model Provider Configuration
AI_PROVIDER=openai
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

