model BusinessMemory {
  id              String           @id @default(uuid())
  organizationId  String
  customerId      String?
  receivableId    String?
  category        MemoryCategory
  type            MemoryType
  timeWindow      MemoryTimeWindow @default(LAST_90_DAYS)
  statement       String
  value           Json             @default("{}")
  currency        String?
  confidence      Decimal          @default(1.0) @db.Decimal(3, 2)
  status          MemoryStatus     @default(ACTIVE)
  version         Int              @default(1)
  firstObservedAt DateTime
  lastObservedAt  DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  receivable   Receivable?              @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  evidence     BusinessMemoryEvidence[]

  @@index([organizationId, customerId, status])
  @@index([organizationId, category, status])
  @@index([organizationId, type, status])
  @@index([organizationId, lastObservedAt])
  @@map("business_memories")
}

model BusinessMemoryEvidence {
  id              String   @id @default(uuid())
  memoryId        String
  businessEventId String
  metadata        Json?
  createdAt       DateTime @default(now())

  memory        BusinessMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  businessEvent BusinessEvent  @relation(fields: [businessEventId], references: [id], onDelete: Cascade)

  @@unique([memoryId, businessEventId])
  @@index([memoryId])
  @@index([businessEventId])
  @@map("business_memory_evidence")
}

enum AICapability {
  COLLECTION_PRIORITIZATION
  CUSTOMER_EXPLANATION
  COLLECTION_RECOMMENDATION
  CUSTOMER_SUMMARY
  COLLECTION_MESSAGE_DRAFT
  BUSINESS_QA
}

enum AIRequestStatus {
  PENDING
  SUCCESS
  FAILED
  RATE_LIMITED
}

enum AIRecommendationAction {
  FOLLOW_UP_NOW
  FOLLOW_UP_LATER
  REQUEST_PAYMENT_DATE
  REQUEST_PARTIAL_PAYMENT
  REVIEW_COMMITMENT
  CHANGE_COLLECTION_CHANNEL
  ESCALATE
  NO_ACTION
}

enum AIRecommendationStatus {
  ACTIVE
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum AIUrgencyLevel {
  HIGH
  MEDIUM
  LOW
}

enum AIConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model AIRequest {
  id            String          @id @default(uuid())
  organizationId String
  userId        String?
  capability    AICapability
  model         String
  promptVersion String          @default("v1")
  status        AIRequestStatus @default(PENDING)
  latencyMs     Int?
  inputTokens   Int?
  outputTokens  Int?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, capability])
  @@index([userId, createdAt])
  @@map("ai_requests")
}

model AIRecommendation {
  id                String                 @id @default(uuid())
  organizationId    String
  userId            String?
  customerId        String?
  receivableId      String?
  capability        AICapability           @default(COLLECTION_RECOMMENDATION)
  action            AIRecommendationAction
  urgency           AIUrgencyLevel         @default(MEDIUM)
  title             String
  reasoningSummary  String
  suggestedChannel  String?
  suggestedMessage  String?
  evidenceMemoryIds String[]               @default([])
  evidenceEventIds  String[]               @default([])
  confidence        AIConfidenceLevel      @default(HIGH)
  status            AIRecommendationStatus @default(ACTIVE)
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  receivable   Receivable?  @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, urgency, status])
  @@map("ai_recommendations")
}

model AIConversation {
  id             String      @id @default(uuid())
  organizationId String
  userId         String
  title          String
  language       AppLanguage @default(EN)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AIMessage[]
  actionProposals AIActionProposal[]

  @@index([organizationId, userId, updatedAt])
  @@map("ai_conversations")
}

enum AIMessageSender {
  USER
  COPILOT
  SYSTEM
}

model AIMessage {
  id                    String          @id @default(uuid())
  conversationId        String
  organizationId        String
  sender                AIMessageSender
  content               String
  language              AppLanguage     @default(EN)
  intent                String?
  evidenceMemoryIds     String[]        @default([])
  evidenceEventIds      String[]        @default([])
  evidenceCustomerIds   String[]        @default([])
  evidenceReceivableIds String[]        @default([])
  metrics               Json?
  createdAt             DateTime        @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_messages")
}

enum ActionProposalStatus {
  SUGGESTED
  CONFIRMED
  EXECUTED
  REJECTED
  EXPIRED
}

model AIActionProposal {
  id              String               @id @default(uuid())
  organizationId  String
  userId          String
  conversationId  String?
  actionType      String
  title           String
  description     String
  payload         Json
  status          ActionProposalStatus @default(SUGGESTED)
  isConsequential Boolean              @default(true)
  confirmedAt     DateTime?
  executedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, status])
  @@map("ai_action_proposals")
}

model VoiceUsage {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  operation      String   // 'STT' | 'TTS'
  language       String
  provider       String   // 'elevenlabs'
  success        Boolean
  durationMs     Int
  characterCount Int?     // for TTS: number of chars synthesized
  errorMessage   String?  // sanitized error message if failed
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([createdAt])
  @@map("voice_usage")
}

