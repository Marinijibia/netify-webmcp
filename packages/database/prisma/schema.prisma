datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  OWNER
  MEMBER
  ADMIN
  MANAGER
  STAFF
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SecurityEventType {
  ACCOUNT_REGISTERED
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  BIOMETRIC_ENABLED
  BIOMETRIC_DISABLED
  DEVICE_ADDED
  DEVICE_REVOKED
  ORGANIZATION_CREATED
  SUSPICIOUS_LOGIN_DETECTED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  BLOCKED
}

enum ContactType {
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

enum ReceivableSource {
  MANUAL
  INVOICE
  CREDIT_SALE
  OTHER
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  POS
  OTHER
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum ActivityType {
  CALL
  WHATSAPP
  SMS
  EMAIL
  IN_PERSON
  PAYMENT_REMINDER
  FOLLOW_UP
  OTHER
}

enum CollectionChannel {
  PHONE
  WHATSAPP
  SMS
  EMAIL
  IN_PERSON
  OTHER
}

enum ActivityOutcome {
  NO_RESPONSE
  CONTACTED
  PROMISED_PAYMENT
  PARTIAL_PAYMENT
  FULL_PAYMENT
  DISPUTE
  REQUESTED_EXTENSION
  WRONG_CONTACT
  CUSTOMER_UNAVAILABLE
  OTHER
}

enum CommitmentStatus {
  PENDING
  FULFILLED
  MISSED
  CANCELLED
  PARTIALLY_FULFILLED
}

enum CommitmentSource {
  MANUAL
  CONVERSATION
  DOCUMENT
  AI_EXTRACTION
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommunicationChannel {
  WHATSAPP
  SMS
  CALL_NOTE
  EMAIL
  IN_PERSON
}

enum MessageSenderType {
  BUSINESS
  CUSTOMER
  SYSTEM
}

enum DocumentType {
  INVOICE
  RECEIPT
  STATEMENT
  CONTRACT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  FAILED
}

enum BusinessEventType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  RECEIVABLE_CREATED
  RECEIVABLE_CANCELLED
  RECEIVABLE_OVERDUE
  RECEIVABLE_PAID
  RECEIVABLE_PARTIALLY_PAID
  PAYMENT_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  PAYMENT_REVERSED
  COLLECTION_ACTIVITY_RECORDED
  PAYMENT_COMMITMENT_CREATED
  PAYMENT_COMMITMENT_FULFILLED
  PAYMENT_COMMITMENT_PARTIALLY_FULFILLED
  PAYMENT_COMMITMENT_MISSED
  PAYMENT_COMMITMENT_CANCELLED
  INVOICE_CREATED
  INVOICE_OVERDUE
  INVOICE_PAID
  PAYMENT_RECEIVED
  PAYMENT_MISSED
  COMMITMENT_CREATED
  COMMITMENT_MISSED
  COMMITMENT_FULFILLED
  CUSTOMER_CONTACTED
  CUSTOMER_REQUESTED_EXTENSION
  DOCUMENT_UPLOADED
  RISK_EVALUATED
}

enum ActorType {
  USER
  SYSTEM
  CUSTOMER
  PROVIDER
}

enum EventSource {
  USER_ACTION
  PAYMENT_PROCESS
  COLLECTION_ACTIVITY
  SCHEDULED_PROCESS
  SYSTEM
}

enum MemoryCategory {
  PAYMENT_BEHAVIOR
  COLLECTION_BEHAVIOR
  COMMITMENT_BEHAVIOR
  RECEIVABLE_HISTORY
  CUSTOMER_ACTIVITY
  CUSTOMER_PREFERENCE
  RELATIONSHIP_HISTORY
}

enum MemoryType {
  PAYMENT_FREQUENCY
  PAYMENT_TIMELINESS
  PAYMENT_COMMITMENT_HISTORY
  PAYMENT_COMMITMENT_FULFILLMENT_RATE
  PAYMENT_COMMITMENT_MISSED_RATE
  PARTIAL_PAYMENT_PATTERN
  COLLECTION_RESPONSE_PATTERN
  EXTENSION_PATTERN
  DISPUTE_PATTERN
  RECEIVABLE_OVERDUE_PATTERN
  CUSTOMER_ACTIVITY_PATTERN
}

enum MemoryTimeWindow {
  LAST_30_DAYS
  LAST_90_DAYS
  LAST_180_DAYS
  ALL_TIME
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  INVALIDATED
}

enum AIActionType {
  FOLLOW_UP_CALL
  SEND_PAYMENT_REMINDER
  OFFER_PAYMENT_PLAN
  ESCALATE
  RECONCILE
}

enum AIActionStatus {
  SUGGESTED
  ACCEPTED
  DISMISSED
  EXECUTED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  GRACE_PERIOD
  BILLING_ISSUE
  CANCELLED
  EXPIRED
  INACTIVE
}

enum AppLanguage {
  EN
  HA
  YO
  IG
  PCM
  FF
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationPriority {
  HIGH
  MEDIUM
  LOW
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  businessType String             @default("OTHER")
  currency     String             @default("NGN")
  country      String             @default("NG")
  timezone     String             @default("Africa/Lagos")
  status       OrganizationStatus @default(ACTIVE)
  logoUrl      String?
  settings     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  memberships          Membership[]
  customers            Customer[]
  receivables          Receivable[]
  collectionActivities CollectionActivity[]
  paymentCommitments   PaymentCommitment[]
  invoices             Invoice[]
  payments             Payment[]
  transactions         Transaction[]
  commitments          Commitment[]
  conversations        Conversation[]
  documents            Document[]
  businessEvents       BusinessEvent[]
  businessMemories     BusinessMemory[]
  aiRequests           AIRequest[]
  aiRecommendations    AIRecommendation[]
  riskAssessments      RiskAssessment[]
  aiInsights           AIInsight[]
  aiActions            AIAction[]
  memoryItems          MemoryItem[]
  notifications        Notification[]
  devicePushTokens     DevicePushToken[]
  subscriptions        Subscription[]
  subscriptionEvents   SubscriptionEvent[]
  entitlements         Entitlement[]
  aiUsages             AIUsage[]
  auditLogs            AuditLog[]
  aiConversations      AIConversation[]
  aiMessages           AIMessage[]
  aiActionProposals    AIActionProposal[]
  voiceUsages          VoiceUsage[]

  @@map("organizations")
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  preferredLanguage   AppLanguage @default(EN)
  isActive            Boolean     @default(true)
  status              UserStatus  @default(ACTIVE)
  isEmailVerified     Boolean     @default(false)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  onboardingCompleted Boolean     @default(false)
  onboardingStep      String      @default("ORGANIZATION")
  onboardingData      Json?       @default("{}")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  memberships             Membership[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  trustedDevices          TrustedDevice[]
  passkeyCredentials      PasskeyCredential[]
  securityEvents          SecurityEvent[]
  performedActivities     CollectionActivity[]
  createdCommitments      PaymentCommitment[]
  authoredBusinessEvents  BusinessEvent[]          @relation("AuthoredBusinessEvents")
  aiRequests              AIRequest[]
  aiRecommendations       AIRecommendation[]
  notifications           Notification[]
  devicePushTokens        DevicePushToken[]
  billedSubscriptions     Subscription[]           @relation("BilledSubscriptions")
  auditLogs               AuditLog[]
  aiConversations         AIConversation[]
  aiActionProposals       AIActionProposal[]
  voiceUsages             VoiceUsage[]
  assignedCustomers       Customer[]               @relation("AssignedCustomers")

  @@map("users")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole         @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("memberships")
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  country        String         @default("NG")
  currency       String         @default("NGN")
  status         CustomerStatus @default(ACTIVE)
  notes          String?
  tags           String[]       @default([])
  metadata       Json?
  assignedStaffId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedStaff        User?                @relation("AssignedCustomers", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  contacts             CustomerContact[]
  receivables          Receivable[]
  collectionActivities CollectionActivity[]
  paymentCommitments   PaymentCommitment[]
  invoices             Invoice[]
  payments             Payment[]
  transactions         Transaction[]
  commitments          Commitment[]
  conversations        Conversation[]
  documents            Document[]
  businessEvents       BusinessEvent[]
  businessMemories     BusinessMemory[]
  aiRecommendations    AIRecommendation[]
  riskAssessments      RiskAssessment[]
  aiInsights           AIInsight[]
  aiActions            AIAction[]
  memoryItems          MemoryItem[]

  @@index([organizationId])
  @@index([organizationId, assignedStaffId])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model CustomerContact {
  id         String      @id @default(uuid())
  customerId String
  type       ContactType @default(PHONE)
  value      String
  label      String?
  isPrimary  Boolean     @default(false)
  isVerified Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, type, isPrimary])
  @@map("customer_contacts")
}

model Receivable {
  id             String           @id @default(uuid())
  organizationId String
  customerId     String
  reference      String?
  description    String?
  originalAmount Decimal          @db.Decimal(18, 2)
  currency       String
  issuedAt       DateTime         @default(now())
  dueDate        DateTime
  source         ReceivableSource @default(MANUAL)
  status         ReceivableStatus @default(OPEN)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments             Payment[]
  collectionActivities CollectionActivity[]
  paymentCommitments   PaymentCommitment[]
  businessEvents       BusinessEvent[]
  businessMemories     BusinessMemory[]
  aiRecommendations    AIRecommendation[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, createdAt])
  @@map("receivables")
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  customerId     String
  invoiceNumber  String
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  total          Float         @default(0)
  paidAmount     Float         @default(0)
  balance        Float         @default(0)
  currency       String        @default("NGN")
  status         InvoiceStatus @default(ISSUED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        InvoiceItem[]
  payments     Payment[]
  commitments  Commitment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  amount      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  customerId     String
  receivableId   String?
  invoiceId      String?
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("NGN")
  paidAt         DateTime      @default(now())
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  status         PaymentStatus @default(CONFIRMED)
  idempotencyKey String?       @unique
  notes          String?
  source         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivable   Receivable?  @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  businessEvents BusinessEvent[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, receivableId])
  @@index([organizationId, status])
  @@index([organizationId, paidAt])
  @@map("payments")
}

model Transaction {
  id             String          @id @default(uuid())
  organizationId String
  customerId     String
  type           TransactionType
  amount         Float
  currency       String          @default("NGN")
  balanceAfter   Float           @default(0)
  referenceType  String?
  referenceId    String?
  description    String
  date           DateTime
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([organizationId, date])
  @@map("transactions")
}

model CollectionActivity {
  id                String            @id @default(uuid())
  organizationId    String
  customerId        String
  receivableId      String
  performedByUserId String
  type              ActivityType
  channel           CollectionChannel
  outcome           ActivityOutcome
  occurredAt        DateTime          @default(now())
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivable      Receivable          @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  performedByUser User                @relation(fields: [performedByUserId], references: [id], onDelete: Cascade)
  commitments     PaymentCommitment[]
  businessEvents  BusinessEvent[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, receivableId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, type])
  @@map("collection_activities")
}

model PaymentCommitment {
  id               String           @id @default(uuid())
  organizationId   String
  customerId       String
  receivableId     String
  createdByUserId  String
  amount           Decimal          @db.Decimal(18, 2)
  currency         String           @default("NGN")
  promisedFor      DateTime
  status           CommitmentStatus @default(PENDING)
  sourceActivityId String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivable     Receivable          @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  createdByUser  User                @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  sourceActivity CollectionActivity? @relation(fields: [sourceActivityId], references: [id], onDelete: SetNull)
  businessEvents BusinessEvent[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, receivableId])
  @@index([organizationId, status])
  @@index([organizationId, promisedFor])
  @@map("payment_commitments")
}

model Commitment {
  id              String           @id @default(uuid())
  organizationId  String
  customerId      String
  invoiceId       String?
  amount          Float
  currency        String           @default("NGN")
  promisedDate    DateTime
  description     String?
  source          CommitmentSource @default(MANUAL)
  sourceReference String?
  confidence      ConfidenceLevel  @default(HIGH)
  status          CommitmentStatus @default(PENDING)
  evidenceId      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, promisedDate])
  @@map("commitments")
}

model Conversation {
  id             String               @id @default(uuid())
  organizationId String
  customerId     String
  channel        CommunicationChannel @default(WHATSAPP)
  title          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, customerId])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  senderType     MessageSenderType @default(BUSINESS)
  senderName     String
  content        String
  timestamp      DateTime          @default(now())
  rawMetadata    Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Document {
  id             String         @id @default(uuid())
  organizationId String
  customerId     String?
  name           String
  type           DocumentType   @default(OTHER)
  fileUrl        String
  fileKey        String
  mimeType       String
  fileSize       Int
  extractedData  Json?
  status         DocumentStatus @default(UPLOADED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@map("documents")
}

model BusinessEvent {
  id                   String            @id @default(uuid())
  organizationId       String
  customerId           String?
  receivableId         String?
  paymentId            String?
  collectionActivityId String?
  paymentCommitmentId  String?
  type                 BusinessEventType @default(CUSTOMER_CREATED)
  occurredAt           DateTime          @default(now())
  recordedAt           DateTime          @default(now())
  actorType            ActorType         @default(USER)
  actorUserId          String?
  source               EventSource       @default(USER_ACTION)
  data                 Json              @default("{}")
  version              Int               @default(1)
  correlationId        String?
  causationId          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  receivable           Receivable?         @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  payment              Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  collectionActivity   CollectionActivity? @relation(fields: [collectionActivityId], references: [id], onDelete: SetNull)
  paymentCommitment    PaymentCommitment?  @relation(fields: [paymentCommitmentId], references: [id], onDelete: SetNull)
  actorUser            User?               @relation("AuthoredBusinessEvents", fields: [actorUserId], references: [id], onDelete: SetNull)
  memoryEvidence       BusinessMemoryEvidence[]

  @@index([organizationId, occurredAt])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, receivableId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@index([organizationId, actorUserId])
  @@index([organizationId, correlationId])
  @@map("business_events")
}

model RiskAssessment {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String
  riskLevel      RiskLevel @default(LOW)
  riskScore      Float     @default(0)
  signals        Json      @default("{}")
  aiExplanation  String?
  evaluatedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([organizationId, riskLevel])
  @@map("risk_assessments")
}

model AIInsight {
  id             String          @id @default(uuid())
  organizationId String
  customerId     String?
  type           String
  title          String
  summary        String
  confidence     ConfidenceLevel @default(HIGH)
  priority       Int             @default(0)
  evidenceRefs   String[]        @default([])
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@map("ai_insights")
}

model AIAction {
  id             String         @id @default(uuid())
  organizationId String
  customerId     String?
  type           AIActionType
  title          String
  description    String
  payload        Json?
  status         AIActionStatus @default(SUGGESTED)
  executedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@map("ai_actions")
}

model MemoryItem {
  id              String                          @id @default(uuid())
  organizationId  String
  customerId      String?
  type            String
  source          String
  sourceReference String?
  content         String
  embedding       Unsupported("vector(1536)")?
  metadata        Json?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@map("memory_items")
}

model Notification {
  id             String               @id @default(uuid())
  organizationId String
  userId         String?
  type           String               @default("SYSTEM")
  signalType     String?
  title          String
  body           String
  data           Json?
  channel        NotificationChannel  @default(IN_APP)
  status         NotificationStatus   @default(DELIVERED)
  priority       NotificationPriority @default(MEDIUM)
  idempotencyKey String?
  readAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, userId, readAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model DevicePushToken {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  token          String
  platform       String    @default("android")
  deviceInfo     Json?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([organizationId, userId])
  @@map("device_push_tokens")
}

model Subscription {
  id                       String             @id @default(uuid())
  organizationId           String
  billingUserId            String?
  plan                     SubscriptionPlan   @default(FREE)
  status                   SubscriptionStatus @default(ACTIVE)
  revenueCatAppUserId      String?
  revenueCatCustomerId     String?
  revenueCatSubscriptionId String?
  productId                String?
  entitlementId            String?
  store                    String?
  environment              String?
  startedAt                DateTime?
  expiresAt                DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  autoRenewing             Boolean            @default(false)
  cancelledAt              DateTime?
  revenueCatId             String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingUser  User?               @relation("BilledSubscriptions", fields: [billingUserId], references: [id], onDelete: SetNull)
  events       SubscriptionEvent[]

  @@index([organizationId])
  @@index([billingUserId])
  @@index([revenueCatAppUserId])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id                String    @id @default(uuid())
  subscriptionId    String?
  organizationId    String?
  revenueCatEventId String    @unique
  eventType         String
  productId         String?
  environment       String?
  payload           Json      @default("{}")
  occurredAt        DateTime  @default(now())
  processedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([organizationId])
  @@index([eventType])
  @@map("subscription_events")
}

model AIUsage {
  id             String   @id @default(uuid())
  organizationId String
