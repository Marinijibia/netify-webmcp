{
  "expo": {
    "name": "Netify",
    "slug": "netify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "netify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#001D31",
      "dark": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#001D31"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netify.app",
      "icon": "./assets/images/icon.png",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#001D31"
      }
    },
    "android": {
      "package": "com.netify.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#001D31"
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#001D31",
        "dark": {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#001D31"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#001D31",
          "dark": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#001D31"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
