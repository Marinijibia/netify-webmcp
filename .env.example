# ==============================================================================
# NETIFY ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# API Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_netify_african_sme_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_key_netify_african_sme_change_in_production
REFRESH_TOKEN_EXPIRATION=7d

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://netify_user:netify_password@localhost:5432/netify_db?schema=public

# Cache & Message Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Provider Configuration
# Supported providers: "gemini" (Development/Default) | "openai" (Production)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Cloud Storage (Documents & Attachments)
GCS_PROJECT_ID=netify-saas
GCS_BUCKET_NAME=netify-business-documents
GCS_KEY_FILE=

# RevenueCat Subscriptions
REVENUECAT_API_KEY=your_revenuecat_api_key
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# Resend (Email Delivery)
RESEND_API_KEY=re_123456789
EMAIL_FROM=notifications@netify.app

# Default Organization Currency (Fallback if not set on organization)
DEFAULT_CURRENCY=NGN
