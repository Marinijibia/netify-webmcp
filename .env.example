# ==============================================================================
# NETIFY ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# API Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_netify_african_sme_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_key_netify_african_sme_change_in_production
REFRESH_TOKEN_EXPIRATION=7d

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://netify_user:netify_password@localhost:5432/netify_db?schema=public

# Cache & Message Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Multi-Model Provider Configuration
# Supported providers: "openai" (Primary Default) | "gemini" | "deepseek" | "openrouter"
AI_PROVIDER=openai

# OPTION 1: OpenRouter Universal Hub (All-in-one access to ChatGPT, Gemini, and DeepSeek with 1 key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# OPTION 2: Direct Provider API Keys (Takes priority when provided)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Cloud Storage (Documents & Attachments)
GCS_PROJECT_ID=netify-saas
GCS_BUCKET_NAME=netify-business-documents
GCS_KEY_FILE=

# RevenueCat Subscriptions
REVENUECAT_API_KEY=your_revenuecat_api_key
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# Resend (Email Delivery)
RESEND_API_KEY=re_123456789
EMAIL_FROM=notifications@netify.app

# Default Organization Currency (Fallback if not set on organization)
DEFAULT_CURRENCY=NGN
